ARG BUILDER_IMAGE=quay.io/projectquay/golang:1.24
ARG RUNTIME_IMAGE=registry.fedoraproject.org/fedora-minimal:42

# Source for the lscpu binary - TARGETPLATFORM architecture
FROM ${BUILDER_IMAGE} AS lscpu-source

# Build the manager binary
FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder
ARG TARGETOS \
    TARGETARCH
ARG STRICTFIPS="false"

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Bring in the go dependencies before anything else so we can take
# advantage of caching these layers in future builds.
COPY vendor/ vendor/
# Copy the go source
COPY build/nodeagent/main.go main.go
COPY api/ api/
COPY controllers/ controllers/
COPY pkg/ pkg/
COPY internal/ internal/

# Create user
RUN mkdir -p /install_root/etc && groupadd -g 1099 "cpm" && useradd -g "cpm" -u 10001 -s /sbin/nologin power-node-agent && tail -1 /etc/passwd > /install_root/etc/passwd

# Build
RUN if [[ "${STRICTFIPS}" == "true" ]]; then \
        GOEXPERIMENT=strictfipsruntime CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=$TARGETARCH GO111MODULE=on go build -tags strictfipsruntime -a -o /install_root/nodeagent ./main.go; \
    else \
        CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=$TARGETARCH GO111MODULE=on go build -a -o /install_root/nodeagent ./main.go; \
    fi

FROM ${RUNTIME_IMAGE}
WORKDIR /
COPY LICENSE /licenses/LICENSE
COPY --from=builder /install_root .
COPY --from=lscpu-source /usr/bin/lscpu /usr/bin/lscpu
RUN microdnf -y install util-linux-core && \
    microdnf clean all && \
    rm -rf /var/cache/yum
USER 10001

ENTRYPOINT ["/nodeagent"]
